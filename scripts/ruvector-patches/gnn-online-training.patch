+//! Supervised online graph ranking bindings; inputs and checkpoints use JSON
+//! strings so browser and Node callers share identical serialization semantics.
+use crate::online::OnlineGraphRanker;
+use wasm_bindgen::prelude::*;
+fn js_error(e:String)->JsValue {JsValue::from_str(&e)}
+fn neighbors(json:&str)->Result<Vec<Vec<f64>>,JsValue>{
+    if json.len()>100_000{return Err(JsValue::from_str("Too many graph features"));}
+    serde_json::from_str(json).map_err(|e|js_error(e.to_string()))
+}
+#[wasm_bindgen]
+pub struct WasmGraphRanker {inner:OnlineGraphRanker}
+#[wasm_bindgen]
+impl WasmGraphRanker {
+    #[wasm_bindgen(constructor)]
+    pub fn new(input_dim:usize,hidden_dim:usize,seed:u32)->Result<WasmGraphRanker,JsValue>{
+        Ok(Self{inner:OnlineGraphRanker::new(input_dim,hidden_dim,seed).map_err(js_error)?})
+    }
+    pub fn predict(&self,node:Vec<f64>,parents:&str)->Result<f64,JsValue>{
+        self.inner.predict(&node,&neighbors(parents)?).map_err(js_error)
+    }
+    pub fn train(&mut self,node:Vec<f64>,parents:&str,target:f64,rate:f64)->Result<f64,JsValue>{
+        self.inner.train(&node,&neighbors(parents)?,target,rate).map_err(js_error)
+    }
+    #[wasm_bindgen(js_name=exportCheckpoint)]
+    pub fn export_checkpoint(&self)->Result<String,JsValue>{self.inner.export_checkpoint().map_err(js_error)}
+    #[wasm_bindgen(js_name=importCheckpoint)]
+    pub fn import_checkpoint(&mut self,json:&str)->Result<(),JsValue>{self.inner.import_checkpoint(json).map_err(js_error)}
+    #[wasm_bindgen(js_name=setWeights)]
+    pub fn set_weights(&mut self,weights:Vec<f64>)->Result<(),JsValue>{self.inner.set_weights(weights).map_err(js_error)}
+    pub fn steps(&self)->u32 {self.inner.steps() as u32}
+}
