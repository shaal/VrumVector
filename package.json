{
  "name": "vectorvroom-a11y",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Development and verification tooling for VectorVroom. The runtime is a static site with a committed Three.js bundle; serving and deploying need no build step.",
  "scripts": {
    "a11y": "node scripts/a11y-contrast.mjs",
    "vendor:three": "node scripts/vendor-three.mjs",
    "test:graphics": "node --test tests/graphics-state.test.mjs",
    "test:graphics:browser": "node tests/graphics-browser.mjs",
    "test:multiplayer": "node --test tests/multiplayer.test.mjs",
    "test:multiplayer:browser": "node tests/multiplayer-browser.mjs",
    "dev:multiplayer": "wrangler dev --config multiplayer/wrangler.jsonc --var ALLOW_LOCAL:true --port 8878",
    "test:learning": "node --test tests/learning.test.mjs tests/decision.test.mjs tests/sim-worker.test.mjs tests/transfer.test.mjs tests/health.test.mjs tests/auto-train.test.mjs tests/demonstration.test.mjs tests/collisions.test.mjs",
    "test:gnn": "node --test tests/graph-learning.test.mjs",
    "test:gnn:wasm": "node tests/gnn-wasm.mjs",
    "benchmark:gnn": "node scripts/benchmark-gnn.mjs",
    "test:learning:wasm": "node tests/learning-wasm.mjs",
    "test:crash-maps": "node --test tests/crash-similarity.test.mjs",
    "test:cloning": "node --test tests/cloning.test.mjs tests/dataset.test.mjs",
    "test:cloning:browser": "node tests/cloning-browser.mjs",
    "test:learning:browser": "node tests/learning-browser.mjs",
    "benchmark:learning": "node scripts/benchmark-learning.mjs",
    "benchmark:crash-similarity": "node scripts/measure-crash-similarity.mjs",
    "benchmark:transfer": "node scripts/benchmark-transfer.mjs",
    "benchmark:health": "node scripts/benchmark-health.mjs",
    "test:auto-train:browser": "node tests/auto-train-browser.mjs",
    "benchmark:auto-train": "node scripts/benchmark-auto-train.mjs",
    "test:demonstration:browser": "node tests/demonstration-browser.mjs",
    "benchmark:collisions": "node scripts/benchmark-collisions.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "4.20260617.1",
    "playwright": "^1.59.1",
    "three": "0.186.0",
    "wrangler": "4.103.0"
  }
}
