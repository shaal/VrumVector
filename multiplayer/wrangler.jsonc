{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "vectorvroom-live",
  "main": "worker.js",
  "compatibility_date": "2026-06-17",
  "workers_dev": true,
  "durable_objects": {"bindings": [{"name": "ROOMS", "class_name": "LiveRoom"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["LiveRoom"]}]
}
