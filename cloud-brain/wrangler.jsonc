{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vectorvroom-brain",
  "main": "build/index.js",
  "compatibility_date": "2026-09-02",
  // new_module_registry gives the Emscripten glue `import.meta.url`.
  "compatibility_flags": ["new_module_registry"],
  "workers_dev": true,
  // The build runs in wrangler's working folder: run wrangler from
  // cloud-brain/, or with `--cwd cloud-brain` (build.cwd is not relative to
  // this file).
  "build": {"command": "bash build.sh"},
  "durable_objects": {"bindings": [{"name": "BRAIN", "class_name": "SharedBrain"}]},
  // Workers Paid (D2, CB5): up to 30 s of CPU a request. A cold start
  // rebuilds the index (a recall then took 0.7 to 1.1 s locally) and a
  // contribution at the cap 53 to 82 ms: far past Free's 10 ms. Only Paid
  // accounts can set CPU limits.
  "limits": {"cpu_ms": 30000},
  // Per-address limits (CB4), counted by the front door before the object:
  // contributions and crash maps; recalls, stats and health checks; forgets
  // (a forget can read every feedback record). A browser sends at most 6
  // contributions and 1 crash map a minute (X4), so 3 browsers can share an
  // address at full rate. The address is a key (IPv6 by /64), never stored.
  // namespace_id: any number, unique among this account's rate limiters.
  "ratelimits": [
    {"name": "WRITE_LIMIT", "namespace_id": "4201", "simple": {"limit": 24, "period": 60}},
    {"name": "READ_LIMIT", "namespace_id": "4202", "simple": {"limit": 60, "period": 60}},
    {"name": "FORGET_LIMIT", "namespace_id": "4203", "simple": {"limit": 3, "period": 60}},
    // Verifications (X1): each runs the simulator, up to 120 s of driving.
    {"name": "VERIFY_LIMIT", "namespace_id": "4204", "simple": {"limit": 6, "period": 60}}
  ],
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["SharedBrain"]}]
}
